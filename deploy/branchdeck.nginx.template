# Replace SERVER_NAME and RELEASE_ROOT before installing as a separate site.
# Add TLS only after DNS points to this server and the certificate is issued.
server {
    listen 80;
    server_name SERVER_NAME;
    root RELEASE_ROOT;
    index index.html;
    autoindex off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
    location / { try_files $uri $uri/ =404; }
    location /downloads/ { try_files $uri =404; }
    location ~ /\. { deny all; }
}
