{
  "name": "branchdeck",
  "productName": "BranchDeck",
  "version": "0.11.0",
  "description": "以工作区组织快捷命令与交互终端的本地开发工具",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "pack": "npm run build && electron-builder --mac dir",
    "dist": "npm run build && electron-builder --mac dmg zip",
    "pack:mas:dev": "npm run build && BRANCHDECK_MAS_MODE=development electron-builder --config electron-builder.mas.cjs --mac mas-dev",
    "pack:mas": "npm run build && electron-builder --config electron-builder.mas.cjs --mac mas",
    "postinstall": "node scripts/prepare-pty.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "marked": "^18.1.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "local.branchdeck.app",
    "productName": "BranchDeck",
    "forceCodeSigning": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "type": "distribution",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "icon": "assets/icon.icns",
      "target": "dir"
    },
    "dmg": {
      "sign": true
    },
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "afterPack": "./scripts/sanitize-package.cjs",
    "publish": null
  },
  "license": "MIT"
}
