{
  "name": "branchdeck",
  "productName": "BranchDeck",
  "version": "0.9.1",
  "description": "以工作区组织快捷命令与交互终端的本地开发工具",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "pack": "npm run build && electron-builder --mac dir",
    "dist": "npm run build && electron-builder --mac zip",
    "postinstall": "node scripts/prepare-pty.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "8.3.1"
  },
  "build": {
    "appId": "local.branchdeck.app",
    "productName": "BranchDeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "assets/icon.icns",
      "target": "dir"
    },
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ]
  }
}
